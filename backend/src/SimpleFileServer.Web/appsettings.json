{
  "AllowedHosts": "*",
  "_Kestrel_Comment": "Default max file size is not that big, so I extend it to 64 GB in bytes",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 68719476736
    }
  },
  "Infrastructure": {
    "FileStore": {
      "StorageFolderPath": "./storage"
    },
    "Database": {
      "ConnectionString": "Data Source=./storage/data.db"
    }
  }
}
